# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# AWS account ID to deploy into (see README "CDK Bootstrap").
CDK_ACCOUNT=

# Comma-separated address(es) that receive all mail sent to quartiersrat.de.
FORWARD_TO=

# Initial comma-separated address(es) that receive mail sent to harthof.quartiersrat.de.
# Stored in SSM after first deploy — update /quartiersrat/harthof/forward-to directly
# to change without redeploying.
FORWARD_TO_HARTHOF=
